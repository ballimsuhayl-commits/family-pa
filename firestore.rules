rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /control/admin {
      allow read: if signedIn();
      allow write: if false;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/control/admin) &&
        request.auth.uid in get(/databases/$(database)/documents/control/admin).data.admins;
    }

    match /familyMembers/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
